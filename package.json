  "description": "Mobikonnect — Full-service mobile marketing & advertising agency. Premium website revamp.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
