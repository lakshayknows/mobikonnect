    "db:seed:case-studies": "dotenv -e .env.local -- tsx scripts/seed-case-studies.ts",
    "admin:reset": "dotenv -e .env.local -- tsx scripts/reset-admin-password.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@vercel/blob": "^2.6.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.3.19",
    "lenis": "^1.1.13",
    "lucide-react": "^0.427.0",
    "next": "^14.2.35",
    "nodemailer": "^9.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.13.0"
