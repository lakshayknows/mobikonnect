    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.13.0",
    "autoprefixer": "^10.4.19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
